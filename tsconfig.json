{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@omniroute/open-sse": ["./open-sse"],
      "@omniroute/open-sse/*": ["./open-sse/*"],
      "@omniroute/browser-pool": ["./packages/browser-pool/src"],
      "@omniroute/ui-kit": ["./packages/ui-kit/src"],
      "@omniroute/ui-kit/*": ["./packages/ui-kit/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": [
    "node_modules",
    ".react-router",
    ".build",
    "open-sse",
    "dist",
    "coverage",
    ".source",
    ".tmp",
    ".claude",
    ".worktrees",
    "@omniroute",
    "_artifacts",
    "_tasks",
    "_ideia",
    "_mono_repo",
    "_references",
    ".opencode",
    ".scratch",
    ".agents",
    ".slim",
    "packages/browser-pool"
  ]
}
