# Environment files: secrets. Only the *.example templates are tracked.
.env*
!.env.example
!.env.selfhost.example
!.env.operator.example
*.api-key

# Root paths starting with "_" are private scratch (for example _artifacts/): never tracked.
# Anchored and without a trailing slash too, so a file or symlink named _x is covered as well.
/_*/
/_*

# Dependencies (the slash-less entry also covers a node_modules symlink in a worktree)
node_modules/
/node_modules

# Build output and generated sources (all reproducible)
/.build/
/dist/
/.react-router/
.source/
*.tsbuildinfo
.tsbuildinfo-*
*.map
*.tgz

# Local data and logs
/data/
.data/
/logs/
*.log
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Tests and quality tooling output
/coverage/
test-results/
playwright-report/
blob-report/
.stryker-tmp/
reports/mutation/
stryker-output-*.json
.eslintcache
.eslintcache-*
/.sandbox/

# Local overrides
docker-compose.override.yml

# Editor, OS and AI-assistant local state
/.claude/
.agents/
.gemini/
.cursor/
.serena/
.aider*
.idea/
.DS_Store
