# Operator access to a hosted OmniRoute instance, for agents and scripts that manage it
# over the HTTP API or MCP. Not read by the server. Copy to .env.operator (gitignored), or run
# scripts/ops/set-operator-key.ps1, which asks for the key without echoing it.
OMNIROUTE_OPERATOR_URL=https://your-domain.example
# A management-scoped API key created in the dashboard (API Keys → scope "manage").
OMNIROUTE_OPERATOR_KEY=
